# OPTIONAL: Android Studio Generate Signed Bundle / APK also supports direct key selection.
# Copy to keystore.properties only for command-line signing; never commit the real file.
# Prefer keeping your keystore outside this project and back it up privately.
storeFile=/absolute/private/path/stbplay-upload.jks
storePassword=REPLACE_LOCALLY
keyAlias=stbplay-upload
keyPassword=REPLACE_LOCALLY
